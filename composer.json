{
    "name": "finiv/job-search-agent",
    "description": "AI job-search agent using an Anthropic Claude tool-calling loop and swappable JobSiteAdapter platforms, starting with Upwork.",
    "type": "project",
    "license": "MIT",
    "bin": [
        "bin/job-agent"
    ],
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "JobSearchAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
